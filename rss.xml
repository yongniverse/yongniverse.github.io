  &lt;img class=&apos;gatsby-resp-image-image&apos; alt=&apos;갓생살기 선언&apos; title=&apos;&apos; src=&apos;/static/78c6b496d2a4ce6bd1ac80339eb9da3a/984b6/gotsaeng.png&apos; srcset=&apos;/static/78c6b496d2a4ce6bd1ac80339eb9da3a/e7570/gotsaeng.png 170w,
